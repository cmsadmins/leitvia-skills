{
	"$schema": "../scenario.schema.json",
	"title": "Rolling back a maintenance package after a person changed the page reports the conflict and keeps both changes",
	"skill": "leitvia-maintain",
	"briefing": "Fix the missing alt text on the workshop page. The photo shows bicycles on repair stands; use the alt text \"Bicycles on repair stands in a bright workshop\". Work directly, our autonomy settings decide. Later: our editor changed the page since, now roll back your maintenance package.",
	"mode": "direct",
	"answers": {
		"Rollback confirmed": "Roll back the maintenance package with the alt text."
	},
	"setup": [
		{
			"step": "runPHP",
			"code": "<?php require_once '/wordpress/wp-load.php';\n$created = WP_Application_Passwords::create_new_application_password( 1, array( 'name' => 'scenario' ) );\nfile_put_contents( '/leitvia-run/admin-password.txt', $created[0] . \"\\n\" );\n$upload = wp_upload_bits( 'workshop.webp', null, file_get_contents( '/leitvia-fixtures/leitvia-maintain/workshop.webp' ) );\n$image = wp_insert_attachment( array( 'post_title' => 'Workshop photo', 'post_mime_type' => 'image/webp', 'post_status' => 'inherit' ), $upload['file'] );\nwp_insert_post( array( 'post_type' => 'page', 'post_status' => 'publish', 'post_title' => 'Workshop', 'post_name' => 'workshop', 'post_content' => \"<!-- wp:paragraph -->\\n<p>Our workshop has room for six bikes at a time.</p>\\n<!-- /wp:paragraph -->\\n\\n<!-- wp:image {\\\"id\\\":{$image},\\\"sizeSlug\\\":\\\"full\\\"} -->\\n<figure class=\\\"wp-block-image size-full\\\"><img src=\\\"{$upload['url']}\\\" class=\\\"wp-image-{$image}\\\"/></figure>\\n<!-- /wp:image -->\" ) );"
		}
	],
	"steps": [
		{
			"ability": "leitvia/audit-site",
			"input": {
				"limit": 20
			},
			"capture": {
				"workshop": "items.2.post",
				"image": "items.2.findings.0.block"
			},
			"expect": {
				"items.length": 3,
				"items.2.findings.length": 1
			}
		},
		{
			"ability": "leitvia/get-page-outline",
			"input": {
				"post": "{{capture.workshop}}"
			},
			"capture": {
				"hash": "hash",
				"text": "blocks.0.id"
			},
			"expect": {
				"blocks.length": 2
			}
		},
		{
			"ability": "leitvia/get-block",
			"input": {
				"post": "{{capture.workshop}}",
				"block": "{{capture.image}}"
			},
			"capture": {
				"attachment": "attributes.id"
			},
			"expect": {
				"name": "core/image"
			}
		},
		{
			"ability": "leitvia/set-alt-text",
			"input": {
				"image": "{{capture.attachment}}",
				"alt": "Bicycles on repair stands in a bright workshop",
				"post": "{{capture.workshop}}",
				"block": "{{capture.image}}",
				"base_hash": "{{capture.hash}}"
			},
			"capture": {
				"package": "package"
			},
			"expect": {
				"mode": "live",
				"package": {
					"$gte": 1
				}
			}
		},
		{
			"ability": "leitvia/get-page-outline",
			"user": "admin",
			"input": {
				"post": "{{capture.workshop}}"
			},
			"capture": {
				"hash": "hash"
			},
			"expect": {
				"blocks.length": 2
			}
		},
		{
			"ability": "leitvia/update-content",
			"user": "admin",
			"input": {
				"post": "{{capture.workshop}}",
				"blocks": [
					{
						"block": "{{capture.text}}",
						"text": "Our workshop has room for eight bikes at a time."
					}
				],
				"base_hash": "{{capture.hash}}",
				"package": "editor-change"
			},
			"capture": {
				"edit": "package"
			},
			"expect": {
				"mode": "package"
			}
		},
		{
			"ability": "leitvia/apply-package",
			"user": "admin",
			"input": {
				"id": "{{capture.edit}}"
			},
			"expect": {
				"state": "applied",
				"conflicts.length": 0
			}
		},
		{
			"ability": "leitvia/rollback",
			"input": {
				"id": "{{capture.package}}"
			},
			"expectError": "leitvia_rollback_conflict"
		}
	],
	"expect": [
		{
			"ability": "leitvia/get-block",
			"input": {
				"post": "{{capture.workshop}}",
				"block": "{{capture.text}}"
			},
			"expect": {
				"inner_html": {
					"$match": "eight bikes"
				}
			}
		},
		{
			"ability": "leitvia/get-block",
			"input": {
				"post": "{{capture.workshop}}",
				"block": "{{capture.image}}"
			},
			"expect": {
				"inner_html": {
					"$match": "alt=\"Bicycles on repair stands"
				}
			}
		},
		{
			"ability": "leitvia/list-packages",
			"input": {
				"state": "applied"
			},
			"expect": {
				"length": 1
			}
		},
		{
			"ability": "leitvia/audit-site",
			"input": {
				"limit": 20
			},
			"expect": {
				"items.2.findings.length": 0
			}
		}
	]
}
