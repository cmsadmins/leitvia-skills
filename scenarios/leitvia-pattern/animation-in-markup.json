{
	"$schema": "../scenario.schema.json",
	"title": "A pattern carries its effect on scroll in the markup, update-block sets the strength on a static block",
	"skill": "leitvia-pattern",
	"briefing": "We need a section with our three promises as an icon list, the points should appear one after another, a bit livelier than usual: Free estimate, Fixed price, Clean site. Make it a reusable pattern, our designer reviews it in the Lab.",
	"mode": "direct",
	"answers": {
		"need": "No existing pattern fits; build a new one and call it Promises. Only the heading Our promises and the three points from the briefing.",
		"review": "The designer moves the pattern to review in the Lab."
	},
	"steps": [
		{
			"ability": "leitvia/create-pattern",
			"input": {
				"title": "Promises",
				"base_hash": "",
				"content": "<!-- wp:group {\"metadata\":{\"name\":\"Promises\"},\"align\":\"full\",\"style\":{\"spacing\":{\"padding\":{\"top\":\"var:preset|spacing|xl\",\"bottom\":\"var:preset|spacing|xl\"}}},\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group alignfull\" style=\"padding-top:var(--wp--preset--spacing--xl);padding-bottom:var(--wp--preset--spacing--xl)\"><!-- wp:heading -->\n<h2 class=\"wp-block-heading\">Our promises</h2>\n<!-- /wp:heading -->\n\n<!-- wp:leitvia/icon-list {\"leitviaAnimation\":\"stagger\"} -->\n<ul role=\"list\" class=\"wp-block-leitvia-icon-list\"><!-- wp:leitvia/icon-list-item -->\n<li class=\"wp-block-leitvia-icon-list-item\"><span class=\"wp-block-leitvia-icon-list-item__text\">Free estimate</span></li>\n<!-- /wp:leitvia/icon-list-item -->\n\n<!-- wp:leitvia/icon-list-item -->\n<li class=\"wp-block-leitvia-icon-list-item\"><span class=\"wp-block-leitvia-icon-list-item__text\">Fixed price</span></li>\n<!-- /wp:leitvia/icon-list-item -->\n\n<!-- wp:leitvia/icon-list-item -->\n<li class=\"wp-block-leitvia-icon-list-item\"><span class=\"wp-block-leitvia-icon-list-item__text\">Clean site</span></li>\n<!-- /wp:leitvia/icon-list-item --></ul>\n<!-- /wp:leitvia/icon-list --></div>\n<!-- /wp:group -->"
			},
			"capture": { "pattern": "target.post" },
			"expect": {
				"mode": "draft",
				"target.post": { "$gte": 1 },
				"findings.length": 0
			}
		},
		{
			"ability": "leitvia/get-block",
			"input": { "post": "{{capture.pattern}}", "block": "p:0.1" },
			"capture": { "hash": "document_hash" },
			"expect": {
				"name": "leitvia/icon-list",
				"attributes.leitviaAnimation": "stagger"
			}
		},
		{
			"ability": "leitvia/update-block",
			"input": {
				"post": "{{capture.pattern}}",
				"block": "p:0.1",
				"attributes": { "leitviaAnimation": "spin" },
				"base_hash": "{{capture.hash}}"
			},
			"expectError": "leitvia_invalid_input"
		},
		{
			"ability": "leitvia/update-block",
			"input": {
				"post": "{{capture.pattern}}",
				"block": "p:0.1",
				"attributes": { "leitviaMotion": "bold" },
				"base_hash": "{{capture.hash}}"
			},
			"expect": { "findings.length": 0 }
		}
	],
	"expect": [
		{
			"ability": "leitvia/get-block",
			"input": { "post": "{{capture.pattern}}", "block": "p:0.1" },
			"expect": {
				"attributes.leitviaAnimation": "stagger",
				"attributes.leitviaMotion": "bold",
				"markup": { "$match": "^<!-- wp:leitvia/icon-list \\{\"leitviaAnimation\":\"stagger\",\"leitviaMotion\":\"bold\"\\} -->\n<ul role=\"list\" class=\"wp-block-leitvia-icon-list\">" }
			}
		},
		{
			"ability": "leitvia/get-page-outline",
			"input": { "post": "{{capture.pattern}}" },
			"expect": {
				"type": "wp_block",
				"status": "draft",
				"blocks.length": 1,
				"blocks.0.name": "core/group"
			}
		}
	]
}
