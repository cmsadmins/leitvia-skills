{
	"$schema": "../scenario.schema.json",
	"title": "Unattended new site: recipe and an extra page wait in one package; the next run waits while it is open",
	"skill": "new-site",
	"briefing": "Follow workflows/new-site.md for a company site of the Speiche bike workshop in Leipzig, with an extra service page at /bike-repair/ that gets visitors to book a repair. There is no brand guide yet. Legal texts follow later. Nobody answers questions during this run: follow the section Unattended of the skill.",
	"mode": "package",
	"unattended": true,
	"budget": {
		"tokens": 15800,
		"files": [
			"skills/leitvia-setup/SKILL.md",
			"skills/leitvia-page/SKILL.md",
			"handbook/abilities/leitvia-get-contract.md",
			"handbook/abilities/leitvia-list-recipes.md",
			"handbook/abilities/leitvia-apply-recipe.md",
			"handbook/abilities/leitvia-check-composition.md",
			"handbook/abilities/leitvia-compose-page.md",
			"handbook/abilities/leitvia-apply-package.md",
			"handbook/abilities/leitvia-list-packages.md"
		]
	},
	"steps": [
		{
			"ability": "leitvia/get-contract",
			"expect": {
				"contract.theme": "leitvia"
			}
		},
		{
			"ability": "leitvia/list-recipes",
			"expect": {
				"length": {
					"$gte": 1
				}
			}
		},
		{
			"ability": "leitvia/apply-recipe",
			"input": {
				"recipe": "leitvia/company",
				"package": "new-site-unattended"
			},
			"capture": {
				"package": "package"
			},
			"expect": {
				"package": {
					"$gte": 1
				}
			}
		},
		{
			"ability": "leitvia/check-composition",
			"input": {
				"slugs": [
					"leitvia/hero-centered",
					"leitvia/proof-trust-strip",
					"leitvia/content-two-columns",
					"leitvia/content-steps",
					"leitvia/content-statement",
					"leitvia/cta-contact"
				],
				"template": "page-landing"
			},
			"expect": {
				"score": {
					"$gte": 80
				}
			}
		},
		{
			"ability": "leitvia/compose-page",
			"input": {
				"title": "Bike repair in Leipzig",
				"frame": "service",
				"slug": "bike-repair",
				"base_hash": "",
				"sections": [
					{
						"pattern": "leitvia/hero-centered",
						"edits": [
							{
								"block": "p:0.0",
								"text": "Speiche bike workshop, Leipzig"
							},
							{
								"block": "p:0.1",
								"text": "Your bike back on the road within 24 hours."
							},
							{
								"block": "p:0.2",
								"text": "We collect your bike anywhere in the city, repair it at a fixed price and bring it back the next day."
							},
							{
								"block": "p:0.3.0",
								"text": "Book a repair by e-mail",
								"url": "mailto:workshop@example.org"
							},
							{
								"block": "p:0.3.1",
								"text": "Call the workshop",
								"url": "tel:+493415550123"
							}
						]
					},
					{
						"pattern": "leitvia/proof-trust-strip",
						"edits": [
							{
								"block": "p:0.0.0.0",
								"text": "Repairs within 24 hours"
							},
							{
								"block": "p:0.0.0.1",
								"text": "Pick-up and delivery in Leipzig"
							},
							{
								"block": "p:0.0.0.2",
								"text": "Fixed prices, no surprises"
							},
							{
								"block": "p:0.0.0.3",
								"text": "Certified mechanics"
							},
							{
								"block": "p:0.0.0.4",
								"text": "Open Monday to Saturday"
							}
						]
					},
					{
						"pattern": "leitvia/content-two-columns",
						"edits": []
					},
					{
						"pattern": "leitvia/content-steps",
						"edits": [
							{
								"block": "p:0.0",
								"text": "How a repair works, in four steps"
							},
							{
								"block": "p:0.1.0.0.0",
								"text": "01"
							},
							{
								"block": "p:0.1.0.0.1",
								"text": "Book"
							},
							{
								"block": "p:0.1.0.0.2",
								"text": "Write or call us with a short description of the problem and the address for pick-up."
							},
							{
								"block": "p:0.1.0.1.0",
								"text": "02"
							},
							{
								"block": "p:0.1.0.1.1",
								"text": "Pick-up"
							},
							{
								"block": "p:0.1.0.1.2",
								"text": "We collect the bike at the agreed time anywhere in Leipzig and take it to the workshop."
							},
							{
								"block": "p:0.1.1.0.0",
								"text": "03"
							},
							{
								"block": "p:0.1.1.0.1",
								"text": "Check and repair"
							},
							{
								"block": "p:0.1.1.0.2",
								"text": "A mechanic checks the bike, names the fixed price and repairs it once you agree."
							},
							{
								"block": "p:0.1.1.1.0",
								"text": "04"
							},
							{
								"block": "p:0.1.1.1.1",
								"text": "Delivery"
							},
							{
								"block": "p:0.1.1.1.2",
								"text": "Within 24 hours the bike is back at your door, checked and ready to ride."
							}
						]
					},
					{
						"pattern": "leitvia/content-statement",
						"edits": [
							{
								"block": "p:0.0",
								"text": "The price we name before the repair is the price you pay."
							},
							{
								"block": "p:0.1.0.0",
								"text": "If a repair turns out to need more work, we call you first. Nothing is added without your yes."
							},
							{
								"block": "p:0.1.1.0",
								"text": "Fixed prices for every repair."
							}
						]
					},
					{
						"pattern": "leitvia/cta-contact",
						"edits": [
							{
								"block": "p:0.0.0.0",
								"text": "Contact"
							},
							{
								"block": "p:0.0.0.1",
								"text": "Book your repair today."
							},
							{
								"block": "p:0.0.0.2",
								"text": "Write or call and a mechanic answers. Tell us what is wrong and where we can collect the bike."
							},
							{
								"block": "p:0.0.1.0.0",
								"text": "Write to workshop@example.org",
								"link_text": "workshop@example.org",
								"url": "mailto:workshop@example.org"
							},
							{
								"block": "p:0.0.1.0.1",
								"text": "Call +49 341 555 0123",
								"link_text": "+49 341 555 0123",
								"url": "tel:+493415550123"
							},
							{
								"block": "p:0.0.1.0.2",
								"text": "Visit us at Karl-Liebknecht-Strasse 12, 04107 Leipzig"
							},
							{
								"block": "p:0.0.1.1",
								"text": "Open Monday to Saturday, 8:00 to 18:00."
							}
						]
					}
				],
				"package": "new-site-unattended"
			},
			"expect": {
				"mode": "package"
			}
		},
		{
			"ability": "leitvia/apply-package",
			"input": {
				"id": "{{capture.package}}"
			},
			"expectError": "leitvia_needs_human"
		},
		{
			"ability": "leitvia/list-packages",
			"input": {
				"state": "open"
			},
			"expect": {
				"length": 1,
				"0.state": "open"
			}
		}
	],
	"expect": [
		{
			"ability": "leitvia/list-packages",
			"input": {
				"state": "open"
			},
			"expect": {
				"length": 1
			}
		},
		{
			"url": "/bike-repair/",
			"status": 404
		}
	]
}
